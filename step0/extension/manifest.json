{
  "manifest_version": 3,
  "name": "互传测试（第 0 步）",
  "version": "0.0.1",
  "description": "手机电脑互传：技术验证用的测试插件，不是正式产品。",
  "minimum_chrome_version": "116",
  "permissions": ["offscreen", "sidePanel", "notifications", "clipboardWrite", "storage"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "互传测试" },
  "icons": { "128": "icon.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "打开互传侧边栏"
    }
  }
}
